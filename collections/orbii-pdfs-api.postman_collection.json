          "id": "2f4d6cfb-464f-44b8-89cc-2541343ef5da",
          "name": "Upload multiple PDFs",
          "request": {
            "name": "Upload multiple PDFs",
            "description": {
              "content": "Allows users to upload multiple PDF files.\nThe uploaded files are stored in a dynamically generated directory with the format: \n`{customer_identifier}-{bank name}-{YYYYMMDD}` inside the container `{user}`.\nIf `bank name` is not provided, it defaults to `\"unspecified_bank\"`.\nIf `date` is not provided, it defaults to the current date in `YYYYMMDD` format.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pdf-upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "List of PDF files to upload"
                },
                {
                  "key": "user",
                  "value": "<string>",
                  "type": "text",
                  "description": "The user, which is also used as the Azure container name"
                },
                {
                  "key": "customer_identifier",
                  "value": "<string>",
                  "type": "text",
                  "description": "Must be a valid Unique identifier, GUID (UUID)"
                },
                {
                  "key": "bank name",
