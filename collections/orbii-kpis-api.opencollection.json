      "items": [
        {
          "info": {
            "name": "Retrieve client KPIs for a specific customer ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sa.orbii.ai/client-kpis/customer/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the customer"
              },
              {
                "name": "user",
                "value": "",
                "type": "query",
                "description": "Database user name"
              },
              {
                "name": "password",
                "value": "",
                "type": "query",
                "description": "Database user password"
              }
            ]
          },
          "docs": "Returns the latest KPI values for the given customer ID."
        },
